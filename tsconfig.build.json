{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
